# Local backend configuration. Copy to .env and pass its path explicitly to
# load_settings(env_file=Path(".env")); the file is not loaded automatically.
# Process environment variables override values in the selected file.
FINANCEIQ_APP_ENV=development
FINANCEIQ_LOG_LEVEL=INFO
# Synthetic example only. Replace user/password/database for your environment;
# URL-encode special characters in credentials. Never commit real credentials.
FINANCEIQ_DATABASE_URL=postgresql+asyncpg://financeiq_runtime:replace_me@127.0.0.1:5432/financeiq
