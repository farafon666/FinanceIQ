# Migration-only configuration. Copy to .env.migrations and explicitly pass
# -x env_file=../.env.migrations when running Alembic from backend.
# Process variables take precedence. Never pass this file to the HTTP app.
FINANCEIQ_MIGRATION_DATABASE_URL=postgresql+asyncpg://financeiq_migrator:replace_me@127.0.0.1:5432/financeiq
